{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Node backend for the realtime subtitle extension: WebSocket endpoint that runs whisper.cpp ASR + Xenova NLLB translation on audio chunks captured from any video webpage.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "setup:offline": "node --use-system-ca scripts/setup-offline.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.7",
    "undici": "^6.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
