# ===== 环境变量模板：复制为 .env.local 并按需填入 =====

# ===== ASR 配置（免费零 API：本地 whisper.cpp）=====
#   一键安装二进制和模型：pnpm --filter @app/server setup:offline
#   也可手动下载 whisper-cli.exe + ggml-small.bin（487MB）放到 apps/server/tools/whisper/
ASR_PROVIDER=whisper-cpp
# WHISPER_CLI_PATH=./apps/server/tools/whisper/whisper-cli.exe
# WHISPER_MODEL_PATH=./apps/server/tools/whisper/models/ggml-small.bin
# WHISPER_THREADS=8                    # 可选，默认自动=min(8, max(4, CPU核数/2))

# ===== 翻译配置（免费零 API：Xenova NLLB-200）=====
#   覆盖 V1 三语种：中 ↔ 英 ↔ 日 全方向
#   首次翻译时自动下载 ~900MB 模型，之后永久离线
TRANSLATOR_PROVIDER=xenova-nllb
# XENOVA_CACHE_DIR=./apps/server/.cache/xenova    # 可选：NLLB 模型缓存目录

# ---- Xenova 网络配置：解决 TypeError: fetch failed / 证书错误 ----
# ① 换 HuggingFace 镜像源（默认已用 hf-mirror.com，国内可直连）：
# XENO_REMOTE_HOST=https://hf-mirror.com/
# ② 临时禁用 TLS 校验（本机开发：MITM 自签证书时使用）：
# HF_MIRROR_INSECURE=1
# ③ 统一代理（被 undici ProxyAgent 自动识别）：
# HTTPS_PROXY=http://127.0.0.1:7890
# ④ 强制纯本地模式（已手动下载模型后完全不走网络）：
# XENO_FORCE_LOCAL=1
# ⑤ 推荐 dev server 启动前：$env:NODE_OPTIONS="--use-system-ca"

# ===== 后端服务端口（仅绑定 127.0.0.1，不对外暴露）=====
PORT=17712

# ===== FFmpeg（若自检找不到，取消注释并填入 Get-Command 输出的绝对路径）=====
#   PowerShell 查路径：Get-Command ffmpeg  | Select-Object -ExpandProperty Source
# FFMPEG_BIN_PATH=C:\FFmpeg\bin\ffmpeg.exe
# FFPROBE_BIN_PATH=C:\FFmpeg\bin\ffprobe.exe
